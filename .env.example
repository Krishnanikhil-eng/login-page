# NexusAuth - Environment Variables Template
# Copy this file to .env.local and populate with your own Supabase project credentials in Phase 2.
# DO NOT commit real secrets or production keys to version control.

# Next.js App URL (used for OAuth redirects and email callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Project Configuration (Phase 2)
# Obtain these from: https://supabase.com/dashboard/project/<project-ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Service Role Key (Phase 2 - Server-side admin only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# Feature Flags
NEXT_PUBLIC_ENABLE_OAUTH=true
NEXT_PUBLIC_ENABLE_PHONE_AUTH=true
